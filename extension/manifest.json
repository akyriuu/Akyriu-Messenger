{
  "manifest_version": 3,
  "name": "Akryiu Messenger",
  "description": "Simple side chat for fast and easy replies, connect friends and stay in touch without leaving your current tab.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "side_panel": { "default_path": "dist/index.html" },
  "action": { "default_title": "Open Orbit Messenger" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
